# Groq API key — required for real AI letter generation.
# Get one at https://console.groq.com/keys
# When unset, the app falls back to a locally-composed sample letter so the
# development environment still works end to end without a key.
GROQ_API_KEY=

# Optional: override the primary and fallback models.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
